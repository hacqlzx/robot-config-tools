{
    "name": "app",
    "private": true,
    "main": "dist-electron/main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "dev:electron": "cross-env ELECTRON=true vite",
        "build:electron": "cross-env ELECTRON=true vite build",
        "preview": "vite preview",
        "package": "pnpm build:electron && electron-builder --win"
    },
    "dependencies": {
        "@ant-design/icons": "^6.2.5",
        "@robot/database": "workspace:*",
        "adm-zip": "^0.5.18",
        "antd": "^6.4.3",
        "archiver": "^8.0.0",
        "axios": "^1.17.0",
        "laz-perf": "0.0.7",
        "mqtt": "^5.15.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.17.0",
        "sql.js": "^1.12.0",
        "xlsx": "^0.18.5",
        "xlsx-js-style": "^1.2.0"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "cross-env": "^7.0.3",
        "electron": "^42.3.3",
        "electron-builder": "^26.15.3",
        "sass": "^1.77.6",
        "typescript": "^5.5.3",
        "vite": "^5.4.0",
        "vite-plugin-electron": "^0.28.7",
        "vite-plugin-electron-renderer": "^0.14.5"
    },
    "build": {
        "appId": "com.robot.config-tools",
        "productName": "七宝智图",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "!node_modules/**/*",
            "node_modules/sql.js/**/*"
        ],
        "extraResources": [
            {
                "from": "src/assets/img/icon.png",
                "to": "icon.png"
            },
            {
                "from": "src/potree-core/PotreeConverter_2.1.3",
                "to": "potree/PotreeConverter_2.1.3"
            },
            {
                "from": "src/pdal-runtime",
                "to": "pdal-runtime"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "src/assets/img/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "electronDownload": {
            "mirror": "https://npmmirror.com/mirrors/electron/"
        },
        "npmRebuild": false,
        "nodeGypRebuild": false,
        "asar": false
    },
    "version": "1.0.0",
    "description": "七宝智图",
    "author": "robot",
    "packageManager": "pnpm@9"
}
